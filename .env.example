# ── べびりん(LINE AI秘書)環境変数 ───────────────────────────
# 実際の値は .env.local に書く(git 管理外)。本番は各ホスティングの環境変数に設定。

# LINE Messaging API チャンネル(必須)
# LINE Developers > チャンネル > Messaging API 設定 から取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# cron(お尻叩き)エンドポイント保護用の任意の文字列(推奨)
# 未設定だと誰でも /api/cron/nudge を叩けてしまう。ランダムな長い文字列を入れる。
CRON_SECRET=

# 永続ストア: Upstash Redis(本番で必須。未設定だとメモリ保存=再起動で消える)
# Upstash コンソール > Redis データベース > REST API から取得
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
